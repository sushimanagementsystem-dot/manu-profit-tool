# --- Core ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/menu_profit?schema=public
PORT=4000
# Comma-separated list of allowed browser origins
FRONTEND_ORIGIN=http://localhost:3000
# Public base URL of this API, used to build the URLs n8n calls back on
PUBLIC_API_BASE_URL=http://localhost:4000
# Private directory for uploads and exports (never served directly)
STORAGE_ROOT=./storage

# --- Retention (hours) ---
DRAFT_TTL_HOURS=2
JOB_TTL_HOURS=48
RAW_FILE_TTL_HOURS=24

# --- AI chat (Anthropic) ---
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5

# --- n8n (leave N8N_BASE_URL empty until the workflows exist; PDF/image extraction is then unavailable) ---
N8N_BASE_URL=
N8N_EXTRACT_PATH=/webhook/mp-extract
N8N_INBOUND_KEY=
EXTRACTION_MODEL=claude-opus-5-5

# --- Secrets: generate each with `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"` ---
N8N_REQUEST_SECRET=
N8N_CALLBACK_SECRET=
N8N_FILE_URL_SECRET=
DOWNLOAD_TOKEN_SECRET=
