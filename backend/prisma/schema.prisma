// Menu Profit — Release 1 schema. See docs/DATABASE_SCHEMA.md for the rationale of every entity.
// Every job-scoped table cascades from AnalysisJob, so deleting a job deletes all of its data.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  DRAFT
  QUEUED
  EXTRACTING
  NORMALIZING
  MATCHING
  CALCULATING
  READY
  FAILED
  EXPIRED
}

enum JobEventType {
  CREATED
  FILE_UPLOADED
  FILE_REMOVED
  SUBMITTED
  STAGE_CHANGED
  TASK_FAILED
  REVISION_APPROVED
  EXPORT_CREATED
  EXPORT_DOWNLOADED
  DELETED
  EXPIRED
}

enum FileCategory {
  MENU
  INVOICE
  POS
}

enum FileStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
  DELETED
}

enum ExtractionMethod {
  DETERMINISTIC
  AI
}

enum TaskType {
  PARSE_FILE
  EXTRACT_FILE
}

enum TaskStatus {
  PENDING
  RUNNING
  DISPATCHED
  SUCCEEDED
  FAILED
}

enum Confidence {
  VERIFIED
  PARTIALLY_VERIFIED
  ESTIMATED
  INCOMPLETE
}

enum RowOrigin {
  EXTRACTED
  USER
}

enum BaseUnit {
  G
  ML
  EACH
}

enum PriceSource {
  INVOICE
  USER
}

enum RecipeSource {
  USER
  AI_ESTIMATE
}

enum MatchMethod {
  EXACT
  FUZZY
  USER
}

enum MatchStatus {
  AUTO_ACCEPTED
  PENDING
  APPROVED
  REJECTED
}

enum RevisionStatus {
  PROPOSED
  APPROVED
  REJECTED
  STALE
}

enum RevisionSource {
  CHAT
  SYSTEM
  /** Edited by the client directly in the results table. */
  MANUAL
}

enum ChatRole {
  USER
  ASSISTANT
}

enum ExportFormat {
  XLSX
}

enum ExportStatus {
  READY
  FAILED
}

model AnalysisJob {
  id               String    @id @default(uuid(4)) @db.Uuid
  accessTokenHash  String    @db.Char(64)
  status           JobStatus @default(DRAFT)
  progress         Json      @default("{}")
  idempotencyKey   String?   @unique
  currency         String    @default("EUR") @db.Char(3)
  currentRevision  Int       @default(0)
  failureCode      String?
  failureMessage   String?
  submittedAt      DateTime? @db.Timestamptz(6)
  rawFilesExpireAt DateTime? @db.Timestamptz(6)
  expiresAt        DateTime  @db.Timestamptz(6)
  purgedAt         DateTime? @db.Timestamptz(6)
  cleanupAttempts  Int       @default(0)
  lastCleanupError String?
  aiUsage          Json      @default("{}")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  events       JobEvent[]
  files        UploadedFile[]
  tasks        ProcessingTask[]
  menuItems    MenuItem[]
  posLines     PosSalesLine[]
  invoices     SupplierInvoice[]
  invoiceLines InvoiceLine[]
  ingredients  Ingredient[]
  prices       IngredientPrice[]
  recipeLines  RecipeLine[]
  matches      MatchSuggestion[]
  assumptions  Assumption[]
  revisions    Revision[]
  snapshots    ResultSnapshot[]
  messages     ChatMessage[]
  exports      ReportExport[]

  @@index([status, expiresAt])
  @@index([expiresAt])
}

model JobEvent {
  id        String       @id @default(uuid(7)) @db.Uuid
  jobId     String       @db.Uuid
  type      JobEventType
  meta      Json         @default("{}")
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  job       AnalysisJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model UploadedFile {
  id               String            @id @default(uuid(7)) @db.Uuid
  jobId            String            @db.Uuid
  category         FileCategory
  originalName     String
  mimeType         String
  sizeBytes        Int
  sha256           String            @db.Char(64)
  storageKey       String
  pageCount        Int?
  status           FileStatus        @default(UPLOADED)
  extractionMethod ExtractionMethod?
  statusMessage    String?
  deletedAt        DateTime?         @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  job              AnalysisJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tasks            ProcessingTask[]

  @@unique([jobId, sha256])
  @@index([jobId, category])
}

model ProcessingTask {
  id               String        @id @default(uuid(7)) @db.Uuid
  jobId            String        @db.Uuid
  fileId           String?       @db.Uuid
  type             TaskType
  status           TaskStatus    @default(PENDING)
  attempt          Int           @default(0)
  maxAttempts      Int           @default(3)
  deadlineAt       DateTime?     @db.Timestamptz(6)
  nextAttemptAt    DateTime      @default(now()) @db.Timestamptz(6)
  n8nExecutionId   String?
  errorCode        String?
  errorMessage     String?
  resultReceivedAt DateTime?     @db.Timestamptz(6)
  usage            Json          @default("{}")
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)
  job              AnalysisJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  file             UploadedFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([jobId, type])
}

model MenuItem {
  id             String         @id @default(uuid(7)) @db.Uuid
  jobId          String         @db.Uuid
  sourceFileId   String?        @db.Uuid
  sourceRef      String?
  name           String
  normalizedName String
  category       String?
  description    String?
  grossPrice     Decimal?       @db.Decimal(14, 4)
  /// Cost per portion entered by hand. When set it replaces the recipe-based cost; null means "use the recipe".
  costOverride   Decimal?       @db.Decimal(14, 4)
  confidence     Confidence     @default(VERIFIED)
  origin         RowOrigin      @default(EXTRACTED)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  job            AnalysisJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  posLines       PosSalesLine[]
  recipeLines    RecipeLine[]

  @@index([jobId, normalizedName])
}

model PosSalesLine {
  id             String      @id @default(uuid(7)) @db.Uuid
  jobId          String      @db.Uuid
  sourceFileId   String      @db.Uuid
  sourceRef      String?
  rawItemName    String
  normalizedName String
  rawCategory    String?
  periodStart    DateTime?   @db.Date
  periodEnd      DateTime?   @db.Date
  quantity       Decimal     @db.Decimal(14, 4)
  netRevenue     Decimal?    @db.Decimal(14, 4)
  grossRevenue   Decimal?    @db.Decimal(14, 4)
  menuItemId     String?     @db.Uuid
  isDuplicate    Boolean     @default(false)
  confidence     Confidence  @default(VERIFIED)
  job            AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  menuItem       MenuItem?   @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([jobId, menuItemId])
  @@index([jobId, normalizedName])
}

model SupplierInvoice {
  id                 String        @id @default(uuid(7)) @db.Uuid
  jobId              String        @db.Uuid
  sourceFileId       String        @db.Uuid
  supplierName       String?
  supplierNormalized String?
  invoiceNumber      String?
  invoiceDate        DateTime?     @db.Date
  currency           String?       @db.Char(3)
  netTotal           Decimal?      @db.Decimal(14, 4)
  vatTotal           Decimal?      @db.Decimal(14, 4)
  grossTotal         Decimal?      @db.Decimal(14, 4)
  duplicateOfId      String?       @db.Uuid
  checks             Json          @default("{}")
  confidence         Confidence    @default(VERIFIED)
  job                AnalysisJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lines              InvoiceLine[]

  @@index([jobId])
}

model InvoiceLine {
  id              String            @id @default(uuid(7)) @db.Uuid
  jobId           String            @db.Uuid
  invoiceId       String            @db.Uuid
  sourceRef       String?
  rawDescription  String
  normalizedName  String
  quantity        Decimal?          @db.Decimal(14, 4)
  packCount       Decimal?          @db.Decimal(14, 4)
  packSize        Decimal?          @db.Decimal(14, 4)
  packUnit        String?
  baseUnit        BaseUnit?
  baseQuantity    Decimal?          @db.Decimal(18, 6)
  unitPrice       Decimal?          @db.Decimal(14, 4)
  lineNet         Decimal?          @db.Decimal(14, 4)
  vatRate         Decimal?          @db.Decimal(7, 4)
  costPerBaseUnit Decimal?          @db.Decimal(18, 8)
  ingredientId    String?           @db.Uuid
  confidence      Confidence        @default(VERIFIED)
  modelConfidence String?
  job             AnalysisJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  invoice         SupplierInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  ingredient      Ingredient?       @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  prices          IngredientPrice[]

  @@index([jobId, ingredientId])
}

model Ingredient {
  id             String            @id @default(uuid(7)) @db.Uuid
  jobId          String            @db.Uuid
  name           String
  normalizedName String
  baseUnit       BaseUnit
  origin         RowOrigin         @default(EXTRACTED)
  job            AnalysisJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  invoiceLines   InvoiceLine[]
  prices         IngredientPrice[]
  recipeLines    RecipeLine[]

  @@unique([jobId, normalizedName])
}

model IngredientPrice {
  id               String       @id @default(uuid(7)) @db.Uuid
  jobId            String       @db.Uuid
  ingredientId     String       @db.Uuid
  source           PriceSource
  invoiceLineId    String?      @db.Uuid
  pricePerBaseUnit Decimal      @db.Decimal(18, 8)
  effectiveDate    DateTime?    @db.Date
  revisionNumber   Int          @default(0)
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  job              AnalysisJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  ingredient       Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  invoiceLine      InvoiceLine? @relation(fields: [invoiceLineId], references: [id], onDelete: Cascade)

  @@index([jobId, ingredientId])
}

model RecipeLine {
  id           String       @id @default(uuid(7)) @db.Uuid
  jobId        String       @db.Uuid
  menuItemId   String       @db.Uuid
  ingredientId String       @db.Uuid
  quantity     Decimal      @db.Decimal(14, 4)
  unit         String
  baseQuantity Decimal      @db.Decimal(18, 6)
  source       RecipeSource
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  job          AnalysisJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  menuItem     MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
}

/// One row per distinct POS item name: the mapping from what the till calls an item to a menu item.
model MatchSuggestion {
  id                String      @id @default(uuid(7)) @db.Uuid
  jobId             String      @db.Uuid
  posNormalizedName String
  posDisplayName    String
  candidateId       String?     @db.Uuid
  score             Decimal     @db.Decimal(5, 4)
  method            MatchMethod
  status            MatchStatus
  decidedInRevision Int?
  job               AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, posNormalizedName])
  @@index([jobId, status])
}

model Assumption {
  id             String      @id @default(uuid(7)) @db.Uuid
  jobId          String      @db.Uuid
  key            String
  value          Json
  source         String
  revisionNumber Int         @default(0)
  job            AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, key])
}

model Revision {
  id                  String         @id @default(uuid(7)) @db.Uuid
  jobId               String         @db.Uuid
  number              Int?
  status              RevisionStatus
  source              RevisionSource
  baseRevision        Int
  operations          Json
  appliedDiff         Json?
  rationale           String?
  impactPreview       Json?
  proposedByMessageId String?        @db.Uuid
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  decidedAt           DateTime?      @db.Timestamptz(6)
  job                 AnalysisJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, number])
  @@index([jobId, status])
}

model ResultSnapshot {
  id             String      @id @default(uuid(7)) @db.Uuid
  jobId          String      @db.Uuid
  revisionNumber Int
  calcVersion    String
  payload        Json
  payloadHash    String      @db.Char(64)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  job            AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, revisionNumber])
}

model ChatMessage {
  id             String      @id @default(uuid(7)) @db.Uuid
  jobId          String      @db.Uuid
  seq            Int
  role           ChatRole
  /// Text shown in the UI.
  content        String
  /// Exact API content blocks, replayed verbatim so the history stays append-only.
  apiContent     Json
  revisionAtTime Int
  usage          Json        @default("{}")
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  job            AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, seq])
}

model ReportExport {
  id               String       @id @default(uuid(7)) @db.Uuid
  jobId            String       @db.Uuid
  revisionNumber   Int
  format           ExportFormat
  status           ExportStatus
  storageKey       String?
  sizeBytes        Int?
  sha256           String?      @db.Char(64)
  snapshotHash     String       @db.Char(64)
  downloadedTokens Json         @default("[]")
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  job              AnalysisJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, revisionNumber, format])
}
